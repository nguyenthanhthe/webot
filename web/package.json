{
  "name": "wv-web-bot",
  "version": "0.0.2",
  "private": true,
  "description": "Headless websocket-injection bot for Wolvesville custom games",
  "type": "module",
  "main": "bot.mjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bot.mjs",
    "login": "node login.mjs",
    "dashboard": "node dashboard.mjs",
    "check": "node --check bot.mjs dashboard.mjs login.mjs payload.js"
  },
  "dependencies": {
    "playwright": "^1.64.1",
    "socket.io-client": "^4.8.1"
  }
}
